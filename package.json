{
  "name": "dsh-plugin-wapliss",
  "version": "1.0.1",
  "description": "Wapliss WhatsApp for DeepSeek Harness: read your WhatsApp chats and groups and send messages, images, documents, audio, video, locations, contacts and polls from the agent, through the Wapliss MCP server.",
  "license": "MIT",
  "author": {
    "name": "netdigitaltech",
    "url": "https://wapliss.com"
  },
  "homepage": "https://wapliss.com/integrations#deepseek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proteuscrypto/wapliss-for-deepseek.git"
  },
  "bugs": {
    "url": "https://github.com/proteuscrypto/wapliss-for-deepseek/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "mcp",
    "mcp-server",
    "whatsapp",
    "whatsapp-mcp",
    "wapliss",
    "ai-agent"
  ],
  "type": "module",
  "icon": "./icon.png",
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "skills/**/SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
